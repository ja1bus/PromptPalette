{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "3.0.0",
  "key": "",
  "minimum_chrome_version": "120",
  "description": "__MSG_extensionDescription__",
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardRead",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "commands": {
    "clipboard-image": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "__MSG_clipboardCommand__"
    },
    "file-image": {
      "description": "__MSG_fileCommand__"
    }
  },
  "default_locale": "en"
}
